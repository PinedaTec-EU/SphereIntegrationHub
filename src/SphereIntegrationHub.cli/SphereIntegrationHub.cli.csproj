<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ReleaseVersion>1.7.25.294</ReleaseVersion>
    <AssemblyVersion>$(ReleaseVersion)</AssemblyVersion>
    <FileVersion>$(ReleaseVersion)</FileVersion>
    <Version>$(ReleaseVersion)</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sih</ToolCommandName>
    <PackageId>SphereIntegrationHub.Tool</PackageId>
    <PackageTitle>SphereIntegrationHub CLI Tool</PackageTitle>
    <Description>CLI tool for API integration testing, reproducible API workflows, and OpenAPI contract validation in CI/CD.</Description>
    <Authors>PinedaTec</Authors>
    <PackageTags>cli;dotnet-tool;api-testing;api-integration-testing;contract-testing;openapi-validation;ci-cd;smoke-tests;workflows;openapi;swagger;integration</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SphereIntegrationHub.HttpPlugin/SphereIntegrationHub.HttpPlugin.csproj" />
    <ProjectReference Include="../SphereIntegrationHub.OpenAIPlugin/SphereIntegrationHub.OpenAIPlugin.csproj" />
    <ProjectReference Include="../SphereIntegrationHub.Shared/SphereIntegrationHub.Shared.csproj" />
    <ProjectReference Include="../SphereIntegrationHub.VaultwardenPlugin/SphereIntegrationHub.VaultwardenPlugin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
